# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix with NEXT_PUBLIC_, never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Used to hash visitor IP addresses. Raw addresses are never stored; what the
# database holds is sha256(pepper + ip), which cannot be reversed without this
# value. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
IP_HASH_PEPPER=

# Public base URL, used for share images and canonical links.
NEXT_PUBLIC_SITE_URL=https://only-text.com

# Google Analytics 4 measurement ID. Defaults to the live property when unset,
# and only loads in production builds. Set it to an empty string to switch
# analytics off entirely for an environment.
NEXT_PUBLIC_GA_ID=G-ZQB4HB9DJJ

# Only needed for running migrations from your machine (scripts/db.mjs).
SUPABASE_DB_PASSWORD=
