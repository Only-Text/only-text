# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix with NEXT_PUBLIC_, never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Used to hash visitor IP addresses. Raw addresses are never stored; what the
# database holds is sha256(pepper + ip), which cannot be reversed without this
# value. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
IP_HASH_PEPPER=

# Public base URL, used for share images and canonical links.
NEXT_PUBLIC_SITE_URL=https://only-text.com

# Only needed for running migrations from your machine (scripts/db.mjs).
SUPABASE_DB_PASSWORD=

# Guards the agent endpoint /api/agent/digest. Any long random string will do.
AGENT_KEY=

# The Bluesky account the daily post goes to.
#
# Use the account's DID here, not its handle. A handle is a name the account
# points at and can be changed at any moment; when it changes, every login with
# the old one starts failing with a 401 and nothing says why. The DID never
# changes. Look it up once:
#   curl "https://bsky.social/xrpc/com.atproto.identity.resolveHandle?handle=<handle>"
BLUESKY_HANDLE=did:plc:...
BLUESKY_APP_PASSWORD=

# Hard off switch for posting, independent of the threshold in the database.
# Anything other than "off" leaves posting enabled.
BLUESKY_POSTING=

# Written by the model that picks the angle for that post.
ANTHROPIC_API_KEY=

# Vercel sends this with every cron call; /api/tick and /api/cron/bluesky both
# refuse a request without it.
CRON_SECRET=

# Bezoeken die niet meetellen in de cijfers, als komma-gescheiden hashes van
# hashClient(ip). Geen ruwe adressen: een IP is een persoonsgegeven, ook je
# eigen. Uitrekenen met:
#   node -e "const{createHash}=require('crypto');console.log(createHash('sha256').update(process.env.IP_HASH_PEPPER+'|'+process.argv[1]+'|').digest('hex'))" <ip>
ANALYTICS_IGNORE_HASHES=
